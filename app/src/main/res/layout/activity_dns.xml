<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/screen_padding" android:background="@color/screen_background">
	<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DNS / Host" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/blue_primary" />
	<EditText android:id="@+id/dns_hostname" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="Nama host, contoh: lokal.test" />
	<EditText android:id="@+id/dns_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Alamat IP, contoh: 192.168.1.10" android:inputType="text" />
</LinearLayout>
