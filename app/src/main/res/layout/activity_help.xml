<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/screen_background"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="@dimen/screen_padding">

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:cardCornerRadius="@dimen/card_corner_radius"
			app:cardElevation="@dimen/card_elevation">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:padding="@dimen/panel_padding">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Bantuan"
					android:textSize="24sp"
					android:textStyle="bold"
					android:textColor="@color/blue_primary" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:text="Cara Penggunaan"
					android:textSize="18sp"
					android:textStyle="bold"
					android:textColor="@color/text_primary" />

				<TextView
					android:id="@+id/help_step1"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="1. Buka halaman Konfigurasi IP dan masukkan alamat IP lokal."
					android:textColor="@color/text_primary"
					android:textSize="15sp" />

				<TextView
					android:id="@+id/help_step2"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="2. Buka halaman Konfigurasi DNS untuk menambahkan hostname."
					android:textColor="@color/text_primary"
					android:textSize="15sp" />

				<TextView
					android:id="@+id/help_step3"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="3. Tambahkan aturan akses di halaman Rules."
					android:textColor="@color/text_primary"
					android:textSize="15sp" />

				<TextView
					android:id="@+id/help_step4"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="4. Tekan Mulai Server pada halaman Server."
					android:textColor="@color/text_primary"
					android:textSize="15sp" />

				<TextView
					android:id="@+id/help_step5"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="5. Buka alamat yang ditampilkan dari perangkat lain."
					android:textColor="@color/text_primary"
					android:textSize="15sp" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
	</LinearLayout>
</ScrollView>
