<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:padding="@dimen/screen_padding"
	android:background="@color/screen_background">

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Aturan Akses"
		android:textSize="24sp"
		android:textStyle="bold"
		android:textColor="@color/blue_primary" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:text="Tambah aturan host yang diizinkan"
		android:textColor="@color/text_secondary"
		android:textSize="14sp" />

	<EditText
		android:id="@+id/rule_input"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:hint="contoh.com"
		android:inputType="text" />

	<Button
		android:id="@+id/rule_add"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:text="Tambah"
		android:textAllCaps="false" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="24dp"
		android:text="Daftar aturan (tekan lama untuk hapus)"
		android:textColor="@color/text_secondary"
		android:textSize="14sp" />

	<ListView
		android:id="@+id/rule_list"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:layout_marginTop="12dp" />
</LinearLayout>
