<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/screen_padding" android:background="@color/screen_background">
	<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Server lokal" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/blue_primary" />
	<TextView android:id="@+id/server_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Siap dijalankan pada port 8080" android:textSize="16sp" android:textColor="@color/text_primary" />
	<Button android:id="@+id/server_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Mulai server" android:textAllCaps="false" />
	<Button android:id="@+id/server_stop" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hentikan server" android:textAllCaps="false" />
</LinearLayout>
