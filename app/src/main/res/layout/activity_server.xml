<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:padding="@dimen/screen_padding"
	android:background="@color/screen_background">

	<com.google.android.material.card.MaterialCardView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardCornerRadius="@dimen/card_corner_radius"
		app:cardElevation="@dimen/card_elevation"
		android:layout_marginBottom="@dimen/section_gap">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="@dimen/panel_padding">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Server Lokal"
				android:textSize="24sp"
				android:textStyle="bold"
				android:textColor="@color/blue_primary" />

			<TextView
				android:id="@+id/server_info"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:text="Siap dijalankan pada port 8080"
				android:textSize="16sp"
				android:textColor="@color/text_primary" />

			<Button
				android:id="@+id/server_start"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:text="Mulai server"
				android:textAllCaps="false" />

			<Button
				android:id="@+id/server_stop"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Hentikan server"
				android:textAllCaps="false" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
